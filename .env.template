# Truth Swarm - Evaluator Attestation Agent Configuration
# Copy this file to ../.env (project root) and fill in your values

# ===== ETHEREUM CONFIGURATION =====
# RPC endpoint for your blockchain network
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Chain ID (11155111 = Sepolia testnet, 1 = Ethereum mainnet, 8453 = Base)
CHAIN_ID=11155111

# Ethereum Attestation Service contract address
# Sepolia: 0xC2679fBD37d54388Ce493F1DB75320D236e1815e
# Base: 0x4200000000000000000000000000000000000021
EAS_CONTRACT_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e

# Your deployed resolver contract address (optional)
RESOLVER_CONTRACT_ADDRESS=

# Private key for signing transactions (⚠️ NEVER commit this!)
# Leave empty to run in mock mode (perfect for testing/development)
PRIVATE_KEY=

# ===== AGENT CONFIGURATION (Optional) =====
# Agentverse API key (for deploying to Agentverse)
AGENTVERSE_API_KEY=

# ===== NOTES =====
# Mock Mode: If PRIVATE_KEY is not set, the agent will run in mock mode
#            - Generates realistic evaluation scores
#            - Returns mock attestation UIDs
#            - Perfect for frontend development and testing
#
# Production Mode: Set PRIVATE_KEY to enable real EAS attestations
#                  - Creates actual blockchain transactions
#                  - Requires funded wallet with ETH for gas
#                  - Returns real attestation UIDs
